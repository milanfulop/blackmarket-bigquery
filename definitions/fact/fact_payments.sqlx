config {
  type: "table",
  schema: "facts",
  description: "Payments fact table",
  assertions: {
    nonNull: ["payment_id", "order_id", "buyer_id", "amount", "currency", "payment_method", "created_at"],
    uniqueKey: ["payment_id"]
  },
  columns: {
    payment_id:     { description: "Primary key" },
    order_id:       { description: "Foreign key to fct_orders" },
    buyer_id:       { description: "Foreign key to dim_user" },
    amount:         { description: "Payment amount in original currency" },
    currency:       { description: "Original currency code" },
    usd_amount:     { description: "Payment amount normalized to USD" },
    payment_method: { description: "card / crypto / wallet" },
    created_at:     { description: "Foreign key to dim_date" },
    confirmed_at:   { description: "Foreign key to dim_date, nullable" },
    is_confirmed:   { description: "True if payment was confirmed" },
    confirmation_delay_hours: { description: "Hours between created and confirmed, null if unconfirmed" }
  }
}

SELECT
  CAST(payment_id     AS STRING)    AS payment_id,
  CAST(order_id       AS INT64)     AS order_id,
  CAST(buyer_id       AS INT64)     AS buyer_id,
  CAST(amount         AS FLOAT64)   AS amount,
  CAST(currency       AS STRING)    AS currency,

  CASE
    WHEN currency = 'USD' THEN CAST(amount AS FLOAT64)
    WHEN currency = 'BTC' THEN CAST(amount AS FLOAT64) * 40000
    WHEN currency = 'ETH' THEN CAST(amount AS FLOAT64) * 2000
    ELSE CAST(amount AS FLOAT64)
  END AS usd_amount,

  CAST(payment_method AS STRING)    AS payment_method,
  CAST(created_at     AS TIMESTAMP) AS created_at,
  CAST(confirmed_at   AS TIMESTAMP) AS confirmed_at,   -- nullable

  -- convenience flags
  confirmed_at IS NOT NULL AS is_confirmed,
  TIMESTAMP_DIFF(
    CAST(confirmed_at AS TIMESTAMP),
    CAST(created_at   AS TIMESTAMP),
    HOUR
  ) AS confirmation_delay_hours                        -- null if unconfirmed

FROM ${ref("raw_oltp", "payments")}
