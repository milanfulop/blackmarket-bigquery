config {
  type: "table",
  schema: "facts",
  description: "Orders fact table",
  assertions: {
    nonNull: ["order_id", "buyer_id", "vendor_id", "order_status", "total_amount", "currency", "created_at"],
    uniqueKey: ["order_id"]
  },
  columns: {
    order_id:     { description: "Primary key", bigqueryPolicyTags: [] },
    buyer_id:     { description: "Foreign key to dim_user" },
    vendor_id:    { description: "Foreign key to dim_user" },
    order_status: { description: "pending / shipped / completed / disputed / cancelled" },
    total_amount: { description: "Order total in original currency" },
    usd_amount:   { description: "Order total normalized to USD" },
    currency:     { description: "Original currency code" },
    created_at:   { description: "Foreign key to dim_date" },
    completed_at: { description: "Foreign key to dim_date, nullable" }
  }
}

SELECT
  CAST(order_id      AS INT64)   AS order_id,
  CAST(buyer_id      AS INT64)   AS buyer_id,
  CAST(vendor_id     AS INT64)   AS vendor_id,
  CAST(order_status  AS STRING)  AS order_status,
  CAST(total_amount  AS FLOAT64) AS total_amount,

  -- normalize to USD using synthetic data
  CASE
    WHEN currency = 'USD' THEN CAST(total_amount AS FLOAT64)
    WHEN currency = 'BTC' THEN CAST(total_amount AS FLOAT64) * 40000
    WHEN currency = 'ETH' THEN CAST(total_amount AS FLOAT64) * 2000
    ELSE CAST(total_amount AS FLOAT64)
  END AS usd_amount,

  CAST(currency      AS STRING)  AS currency,
  CAST(created_at    AS DATE)    AS created_at,
  CAST(completed_at  AS DATE)    AS completed_at   -- nullable, no COALESCE

FROM ${ref("raw_oltp", "orders")}
