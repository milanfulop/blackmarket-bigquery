config {
  type: "table",
  schema: "time_series",
  description: "Reputation snapshots time series table",
  assertions: {
    nonNull: ["snapshot_id", "user_id", "avg_rating", "total_reviews", "calculated_at"],
    uniqueKey: ["snapshot_id"]
  },
  columns: {
    snapshot_id:    { description: "Primary key" },
    user_id:        { description: "Foreign key to dim_user" },
    avg_rating:     { description: "Average rating at this point in time" },
    total_reviews:  { description: "Total reviews at this point in time" },
    calculated_at:  { description: "When this snapshot was taken" },
    is_most_recent: { description: "True if this is the latest snapshot for this user" },
    rating_change:  { description: "Difference from previous snapshot, null if first" }
  }
}

SELECT
  CAST(snapshot_id   AS STRING)    AS snapshot_id,
  CAST(user_id       AS INT64)     AS user_id,
  CAST(avg_rating    AS FLOAT64)   AS avg_rating,
  CAST(total_reviews AS INT64)     AS total_reviews,
  CAST(calculated_at AS TIMESTAMP) AS calculated_at,

  ROW_NUMBER() OVER (
    PARTITION BY user_id
    ORDER BY calculated_at DESC
  ) = 1                            AS is_most_recent,

  -- how much did rating change since last snapshot (key fraud signal)
  avg_rating - LAG(avg_rating) OVER (
    PARTITION BY user_id
    ORDER BY calculated_at ASC
  )                                AS rating_change

FROM ${ref("raw_oltp", "reputation_snapshots")}
