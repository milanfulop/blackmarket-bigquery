config {
  type: "assertion",
  description: "Risk scores time series checks"
}

-- check 1: exactly one is_most_recent = true per user
WITH most_recent_counts AS (
  SELECT
    user_id,
    COUNTIF(is_most_recent = true) AS most_recent_count
  FROM ${ref("time_series", "ts_risk_scores")}
  GROUP BY user_id
)
SELECT user_id
FROM most_recent_counts
WHERE most_recent_count != 1

UNION ALL

-- check 2: risk_score must be between 0 and 1
SELECT CAST(user_id AS STRING)
FROM ${ref("time_series", "ts_risk_scores")}
WHERE risk_score < 0 OR risk_score > 1

UNION ALL

-- check 3: risk_level must match risk_score band
SELECT CAST(user_id AS STRING)
FROM ${ref("time_series", "ts_risk_scores")}
WHERE
  (risk_score > 0.7  AND risk_level != 'high')   OR
  (risk_score > 0.4  AND risk_score <= 0.7 AND risk_level != 'medium') OR
  (risk_score <= 0.4 AND risk_level != 'low')

UNION ALL

-- check 4: calculated_at must not be in the future
SELECT CAST(user_id AS STRING)
FROM ${ref("time_series", "ts_risk_scores")}
WHERE calculated_at > CURRENT_TIMESTAMP()
